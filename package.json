{
  "name": "plugin-composer-animal",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "Interactive pet companion for Composer",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.zh-Hans.md",
    "docs/pet-system.md",
    "cordisx-package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/runtime/module.js",
  "types": "./dist/types/plugin-composer-animal.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/plugin-composer-animal.d.ts",
      "import": "./dist/runtime/module.js",
      "default": "./dist/runtime/module.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/package-manifest.mjs",
    "check": "tsc -p tsconfig.json --noEmit && npm run build && node --test test/*.mjs",
    "dev": "cordisx dev ./src/plugin-composer-animal.tsx",
    "dev:dry-run": "cordisx dev ./src/plugin-composer-animal.tsx --dry-run",
    "test": "node --test test/*.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "cordisx": "file:.cache/sdk/cordisx-efbff656d84b.tgz",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vite": "8.2.2",
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#f3e18c925c34d90fdf203c158811cef10f7ebf57"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@oneworks/avatar": "1.0.0-rc.9",
    "@oneworks/avatar-react": "file:.development/dependencies/avatar-react-a06ba84-rc9.tgz"
  },
  "overrides": {
    "@cordisx/protocol": "$@cordisx/protocol"
  }
}
